# Reference only. Add these values in Render's Environment dashboard.
# Never commit a real .env or put database/storage secrets in VITE_* variables.
DJANGO_DEBUG=false
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-with-a-unique-random-secret-of-at-least-50-characters
# Render adds its own .onrender.com hostname automatically. These are optional
# until you add a custom domain; use exact hosts/origins, never '*' in production.
DJANGO_ALLOWED_HOSTS=learn.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://learn.example.com

# Copy the Session pooler URI from Supabase Connect; URL-encode the password.
DATABASE_URL=postgresql://postgres.PROJECT:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
DATABASE_CONN_MAX_AGE=60
DATABASE_CONNECT_TIMEOUT=5

# Create a PRIVATE bucket. Use actual S3 credentials, NOT anon/service-role JWTs.
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_STORAGE_BUCKET=course-materials
SUPABASE_S3_ACCESS_KEY_ID=replace-with-s3-access-key
SUPABASE_S3_SECRET_ACCESS_KEY=replace-with-s3-secret-key
# Copy the region from Supabase Storage S3 settings; do not infer it from Render.
SUPABASE_S3_REGION=eu-central-1
SUPABASE_STORAGE_SIGNED_URL_TTL=300
MAX_COURSE_FILE_SIZE_MB=25

WEB_CONCURRENCY=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60
ADMIN_LOGIN_FAILURE_LIMIT=5
ADMIN_LOGIN_COOLOFF_MINUTES=15
DJANGO_LOG_LEVEL=INFO
DJANGO_SECURE_SSL_REDIRECT=true
# Raise to 31536000 after confirming HTTPS on the real domain.
DJANGO_SECURE_HSTS_SECONDS=3600
# Leave false unless ALL affected subdomains use HTTPS. Preload is a separate,
# deliberate domain-owner decision; see the deployment checklist.
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
